# 依赖与构建产物
node_modules/
dist/
# Cargo workspace（target 移到仓库根）
target/
src-tauri/target/
src-tauri/gen/
# 核心插件打包资源（release DLL，由 pnpm build:core:release 生成）
src-tauri/resources/_core/
# 捆绑 Python 运行时（python-build-standalone，由 pnpm fetch:python 生成）
src-tauri/resources/python/

# 系统与编辑器
.DS_Store
Thumbs.db
*.log
src-tauri/log.txt
.idea/
.vscode/

# Python 缓存
__pycache__/
*.pyc

# process 插件依赖目录（由「安装依赖」按钮 / pip install --target 生成，不入库；
# 仓库只提交 plugin.json + main.py + requirements.txt 源码）
plugins/*/vendor/
plugins/*/env/
plugins/*/.venv/

# 外部插件自带前端构建产物（源码 ui/index.ts 提交；index.js/style.css 本地构建，
# 见 scripts/build-external-ui.mjs）
plugins/*/ui/index.js
plugins/*/ui/style.css
target/external-ui/

# 插件模板构建产物（templates/external-plugin 的 npm run build 生成，同外部插件不入库）
templates/*/ui/index.js
templates/*/ui/style.css

# 本地数据（vault 用户数据不入库）
.data/
