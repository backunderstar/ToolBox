# 依赖与构建产物
node_modules/
dist/
# Vditor 离线资源例外（随仓库提交，保证离线可用；升级用 pnpm sync:vditor 重建）
!public/vditor/dist/
# Cargo workspace（target 移到仓库根）
target/
src-tauri/target/
src-tauri/gen/
# 核心插件打包资源（release DLL，由 pnpm build:core:release 生成）
src-tauri/resources/_core/

# 系统与编辑器
.DS_Store
Thumbs.db
*.log
src-tauri/log.txt
.idea/
.vscode/

# Python 缓存
__pycache__/
*.pyc

# 外部插件自带前端构建产物（源码 ui/index.tsx 提交；index.js/style.css 本地构建，
# 见 scripts/build-external-ui.mjs）
plugins/*/ui/index.js
plugins/*/ui/style.css
target/external-ui/

# 本地数据（vault 用户数据不入库）
.data/
