{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ToolBox",
  "version": "0.4.0",
  "identifier": "com.toolbox.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build:core:release && pnpm bundle:plugins && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ToolBox",
        "width": 1240,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "devCsp": null,
      "csp": "default-src 'self'; script-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: http: https:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ]
      }
    },
    "resources": [
      "resources/_core",
      "resources/python",
      "resources/bundled-plugins"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc3NjlBODcwNTE0QzFCOUIKUldTYkcweFJjS2hwZDFlV2VNWm1ValdtK3V2UlFtbFloR3duVjJxaWp3S2w4a0xhcFFtN0ZkL3AK",
      "endpoints": [
        "https://github.com/backunderstar/ToolBox/releases/latest/download/latest.json"
      ]
    }
  }
}
